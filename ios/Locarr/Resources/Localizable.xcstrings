          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Javne stranice koje Locarr pretražuje sam, bez Prowlarra ili Jacketta. Uključi stranicu i dodat će se s razumnim zadanim postavkama; kasnije je prilagodi pod Uredi."
          }
        }
      }
    },

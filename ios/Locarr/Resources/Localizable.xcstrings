    "settings.notifHonest": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no push service: Locarr asks the server for news while the app is open (every minute) and when iOS gives it background time. iOS decides when that is: usually a few times a day for an app you open often, not at all after you swipe the app away, in Low Power Mode or with Background App Refresh off. Notifications can therefore arrive late. For instant alerts set up ntfy, Gotify, Pushover or Telegram on the web (Account → My notifications)."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nema push usluge: Locarr pita poslužitelj za novosti dok je aplikacija otvorena (svake minute) i kad mu iOS da vremena u pozadini. iOS odlučuje kada: obično nekoliko puta dnevno za aplikaciju koju često otvaraš, a nikako nakon što je zatvoriš povlačenjem, u načinu štednje energije ili kad je osvježavanje u pozadini isključeno. Zato obavijesti mogu kasniti. Za trenutne obavijesti postavi ntfy, Gotify, Pushover ili Telegram na webu (Račun → Moje obavijesti)."
          }
        }
      }
    },
    "settings.notifPermission": {
      "extractionState": "manual",
      "localizations": {

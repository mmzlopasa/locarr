<?xml version="1.0" encoding="utf-8"?>
<!--
  Locarr usually runs at home (http://192.168.1.10:8484), so plain HTTP is allowed: Android
  blocks it by default since 9. HTTPS servers are verified against the system CAs and the CAs
  the user installed on the phone (a home CA for a self-signed certificate). See D-087.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>

# Copy to .env next to docker-compose.yml and adjust. Never commit .env.

# Image tag: latest (releases), edge (main branch) or a version like 0.1.0.
LOCARR_VERSION=latest

# Where the web interface listens on the host. 127.0.0.1 keeps it local (put a
# reverse proxy in front for remote access); use 8484 alone to listen everywhere.
HTTP_PORT=127.0.0.1:8484

# Host folders.
#   CONFIG_DIR holds the database and the encryption key (back it up).
#   DATA_DIR holds media and downloads together, for hardlinks:
#     DATA_DIR/media/movies, DATA_DIR/media/tv, DATA_DIR/media/music
#     DATA_DIR/downloads/torrents, DATA_DIR/downloads/usenet
CONFIG_DIR=./config
DATA_DIR=./data

# User and group that own your media (id -u, id -g). Locarr runs as this user.
PUID=1000
PGID=1000
UMASK=002
TZ=Etc/UTC

# debug, info, warn or error.
LOCARR_LOG_LEVEL=info

# Reverse proxies whose X-Forwarded-For is trusted (comma-separated IPs/CIDRs),
# e.g. 172.16.0.0/12 for a proxy in another Docker network.
LOCARR_TRUSTED_PROXIES=

# Fixed first-run setup code. Leave empty: a random one is printed to the log.
LOCARR_SETUP_CODE=

# Sign-in attempts per client address: "perMinute,burst", or 0 to turn off.
LOCARR_AUTH_RATE_LIMIT=10,10

# Advanced (set in docker-compose.yml environment if needed):
#   LOCARR_HTTP_ADDR   listen address inside the container (default :8484)
#   LOCARR_CONFIG_DIR  config folder inside the container (default /config)
#   LOCARR_DATA_ROOTS  folders request paths may point into (default /data, comma-separated)
